# Paths excluded from public repository sync.
# Used by .github/workflows/sync-public.yml to filter private content.
# This file is informational — the workflow uses rsync --exclude + defensive rm.
#
# Sync mode   : rsync incremental (preserves public repo git history)
# Time gate   : 08:00-19:00 CST skipped; manual dispatch + tag push always sync
# Private repo : claw-network/telagent-dev  (daily development)
# Public repo  : claw-network/telagent      (open-source release)

# ── Entire directories excluded via rsync --exclude ──

# docs/ is excluded entirely, then docs/guides/ and docs/README.md are synced back
docs/design/
docs/implementation/
docs/issues/
docs/issues/reply/
docs/versioning/

# Operational skills (server IPs, SSH key paths, deploy procedures)
skills/

# Local dev infrastructure (production IPs, SSH keys, .env.cloud contents)
localdev/

# Temporary files
temp/

# ── Individual files excluded ──

# Deploy scripts with hard-coded server IPs/SSH keys
scripts/deploy-node.sh
scripts/deploy-install-assets.sh
scripts/redeploy.sh

# This file itself
.public-sync-ignore

# Private copilot instructions (replaced with .public.md version on sync)
.github/copilot-instructions.md
.github/copilot-instructions.public.md

# Sync workflow itself (public repo has no need for it)
.github/workflows/sync-public.yml
